---
import SiteLayout from '../layouts/SiteLayout.astro';
import Scene from '../components/Scene.astro';
import { projects, experiments } from '../data/projects';
---
<SiteLayout title="CY · 做少数东西，做到趁手" description="CY 的个人作品站。KnowWeft 知织、Tessera 千机，以及两个进行中的项目。Solo-built software for knowledge & everyday work.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-grid container">
      <div class="hero-copy">
        <div class="intro"><span class="intro-dot"></span>INDEPENDENT DEVELOPER</div>
        <h1 id="hero-title">做少数东西，<br/>做到趁手<span class="period">。</span></h1>
        <p class="hero-description">Solo-built software for knowledge & everyday work.<br/>KnowWeft 与 Tessera 已发布，<br class="mobile-break"/>两个新项目正在构建。</p>
        <div class="hero-actions"><a class="button primary" href="#works">看作品 <span aria-hidden="true">↓</span></a><a class="about-link" href="#about">关于我 <span aria-hidden="true">＋</span></a></div>
      </div>
      <div class="hero-art">
        <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
        <div class="scene-wrap"><Scene variant="home" /></div>
        <div class="art-note note-top"><span class="cross">+</span><span>少，但是精。<br/><small>Less, but better</small></span></div>
        <div class="art-note note-bottom"><span class="note-line"></span><span id="scene-caption">东西不多，都在这了。<small id="scene-caption-en">Everything I've shipped.</small></span></div>
        <div class="scene-switcher" role="group" aria-label="切换空间装置主题">
          <button type="button" data-project="all" aria-pressed="true" aria-label="所有作品主题"><span class="swatch all"></span></button>
          <button type="button" data-project="knowweft" aria-pressed="false" aria-label="KnowWeft 主题"><span class="swatch weave"></span></button>
          <button type="button" data-project="tessera" aria-pressed="false" aria-label="Tessera 主题"><span class="swatch tessera"></span></button>
        </div>
      </div>
    </div>
    <div class="hero-bottom container"><span class="scroll-cue"><span></span>SCROLL</span><span class="hero-signature">Independent projects <i>by CY</i></span><span class="location-dot">持续更新</span></div>
  </section>

  <section class="works container" id="works" aria-labelledby="works-title">
    <div class="section-top"><div><p class="eyebrow">SHIPPED · 已发布</p><h2 id="works-title">作品<span class="small-star" aria-hidden="true">✳</span></h2></div><p class="section-aside">解决自己的问题，<br/>顺便解决你的。</p></div>
    <div class="project-grid">
      <article class="project knowweft-project">
        <a class="project-stage weave-stage" href="/knowweft/" aria-label="探索 KnowWeft 知织">
          <div class="stage-top"><span class="stage-brand"><img src="/brand/knowweft-dark.svg" width="28" height="24" alt=""/> KnowWeft</span><span>Knowledge → Video & PPTX</span></div>
          <div class="weave-illustration" aria-hidden="true">
            <svg class="weave-connections" viewBox="0 0 580 300" fill="none"><path d="M60 128H145Q175 128 175 95V60H264M60 128H228M60 128H145Q175 128 175 175V220H264" stroke="#73c3b2" stroke-opacity=".5"/><path d="M250 60C330 60 300 120 355 120M250 128H355M250 220C330 220 300 150 355 150" stroke="#73c3b2" stroke-opacity=".2" stroke-dasharray="4 5"/></svg>
            <div class="idea-node"><span>一个想法</span><i></i></div>
            <div class="tree-items"><span>建立联系</span><span>整理结构</span><span>展开表达</span></div>
            <div class="mini-film"><div class="film-tools"><i></i><i></i><i></i><span>场景预览</span></div><div class="film-body"><span class="film-kicker">KnowWeft · 知织</span><strong>让知识<br/>被看见。</strong><div class="film-symbol"><i></i><i></i><i></i></div></div><div class="film-timeline"><span></span><span></span><span></span><b></b></div></div>
          </div>
          <div class="stage-bottom"><span>知识树 <b>→</b> 视频 & 课件</span><span class="round-arrow" aria-hidden="true">↗</span></div>
        </a>
        <div class="project-description"><div><h3>{projects[0].name}<span>知织</span></h3><p>{projects[0].description}</p></div><span class="status"><i></i>可下载</span></div>
        <div class="project-tags"><span>知识可视化</span><span>视频编排</span><span>原生 PPTX</span></div>
      </article>
      <article class="project tessera-project">
        <a class="project-stage tessera-stage" href="/tessera/" aria-label="探索 Tessera 千机">
          <div class="stage-top"><span class="stage-brand"><img src="/brand/tessera.svg" width="23" height="23" alt=""/> Tessera</span><span>日常趁手的小工具</span></div>
          <div class="tile-illustration" aria-hidden="true">
            <div class="tile-grid"><div class="tool-tile"><span>⌘</span><small>快捷工具</small></div><div class="tool-tile tile-clock"><span>◷</span><small>世界时钟</small></div><div class="tool-tile"><span>⤢</span><small>截图标注</small></div><div class="tool-tile"><span>±</span><small>科学计算</small></div><div class="tool-tile tile-center"><img src="/brand/tessera.svg" width="50" height="50" alt=""/></div><div class="tool-tile"><span>⇌</span><small>单位换算</small></div><div class="tool-tile"><span>▧</span><small>图片实验室</small></div><div class="tool-tile"><span>Aa</span><small>文本处理</small></div><div class="tool-tile tile-empty"><span>＋</span><small>更多可能</small></div></div>
          </div>
          <div class="stage-bottom"><span>不多，但够用。</span><span class="round-arrow" aria-hidden="true">↗</span></div>
        </a>
        <div class="project-description"><div><h3>{projects[1].name}<span>千机</span></h3><p>{projects[1].description}</p></div><span class="status"><i></i>可下载</span></div>
        <div class="project-tags"><span>桌面工具箱</span><span>插件扩展</span><span>本地优先</span></div>
      </article>
    </div>
  </section>

  <section class="lab-section" id="lab" aria-labelledby="lab-title"><div class="container">
    <div class="section-top"><div><p class="eyebrow">WIP · 进行中</p><h2 id="lab-title">实验</h2></div><span class="lab-label"><i></i>正在构建</span></div>
    <div class="experiments">{experiments.map(experiment => <article class="experiment"><div class:list={['experiment-art',experiment.icon]} aria-hidden="true">{experiment.icon === 'reflection' ? <><i></i><i></i><i></i><span>自 / 省</span></> : <><div class="creation-orbit"></div><div class="creation-orbit"></div><span>✧</span></>}</div><div class="experiment-content"><span class="experiment-category">{experiment.category}</span><h3>{experiment.name}</h3><h4>{experiment.title}</h4><p>{experiment.description}</p></div><span class="experiment-status">WIP</span></article>)}</div>
    <p class="lab-footnote">都从自己的需求出发。做完了，就搬到上面去。</p>
  </div></section>

  <section class="about-section container" id="about" aria-labelledby="about-title">
    <div class="about-identity"><div class="signature-mark" aria-hidden="true">cy<span>.</span></div><span>开发者，也是第一个用户。</span></div>
    <div class="about-copy"><p class="eyebrow">ABOUT · 关于</p><h2 id="about-title">自己想用的，<br/>就自己写。</h2><p>做知识表达与日常工具方向的软件。<br class="desktop-break"/>每个作品，都先过自己这一关。</p><p>两个已发布，两个进行中。<br/>都在 GitHub 上，欢迎来看。</p><a href="https://github.com/cyamz" target="_blank" rel="noopener noreferrer" class="about-github">GitHub <span aria-hidden="true">↗</span></a></div>
  </section>
</SiteLayout>

<script>
  const sceneCopy = {
    all: ['东西不多，都在这了。', "Everything I've shipped."],
    knowweft: ['知识，先有结构。', 'KnowWeft · Structure first, story next.'],
    tessera: ['工具，需要时就位。', 'Tessera · Ready when you are.'],
  };
  document.querySelectorAll<HTMLButtonElement>('[data-project]').forEach(button => {
    button.addEventListener('click', () => {
      const project = button.dataset.project as keyof typeof sceneCopy;
      document.querySelectorAll('[data-project]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      const caption = document.querySelector('#scene-caption');
      const sub = document.querySelector('#scene-caption-en');
      if (caption?.firstChild && sub) { caption.firstChild.textContent = sceneCopy[project][0]; sub.textContent = sceneCopy[project][1]; }
      window.dispatchEvent(new CustomEvent('portfolio:project', { detail: { project } }));
    });
  });
</script>

<style>
  .hero{position:relative;isolation:isolate;overflow:hidden;background:radial-gradient(ellipse at 75% 42%,#1c265034 0,transparent 56%)}
  .hero:before{content:"";position:absolute;inset:0;pointer-events:none;z-index:-1;background-image:radial-gradient(#99abc535 .55px,transparent .55px);background-size:29px 29px;mask-image:linear-gradient(90deg,transparent,#0005)}
  .hero-grid{display:grid;grid-template-columns:1fr 1fr;min-height:713px;position:relative}.hero-copy{padding-top:78px;padding-bottom:78px;position:relative;z-index:2;pointer-events:none}.hero-copy a{pointer-events:auto}.intro{display:flex;align-items:center;gap:10px;font-size:11px;color:#b3bcd0;letter-spacing:.08em;margin-bottom:34px}.intro-dot{width:5px;height:5px;border-radius:50%;background:#9daff7;box-shadow:0 0 12px #a7b7ff85}h1{font-size:clamp(53px,5.45vw,82px);line-height:1.28;letter-spacing:-.055em;font-weight:500;color:#f1f3fc}.period{color:#b4c0eb}.hero-description{font-size:14px;color:#98a5be;line-height:1.95;margin-top:29px;letter-spacing:.04em}.hero-actions{display:flex;align-items:center;gap:30px;margin-top:31px}.hero-actions .primary{min-width:142px}.about-link{font-size:12px;display:flex;align-items:center;gap:18px;color:#c6cede}.about-link:hover{color:#fff}.mobile-break{display:none}.hero-art{position:relative;min-width:0}.scene-wrap{position:absolute;inset:0 -76px 0 -100px}.art-orbit{position:absolute;left:50%;top:48%;border:1px solid #839bd60c;border-radius:50%;transform:translate(-50%,-50%);width:570px;height:570px;pointer-events:none}.orbit-two{width:720px;height:720px}.art-note{position:absolute;z-index:1;font-size:12px;letter-spacing:.05em;display:flex;align-items:flex-start;gap:12px;pointer-events:none}.art-note small{display:block;font-size:10px;letter-spacing:.015em;color:#74839f;margin-top:7px}.note-top{top:78px;right:8px}.cross{color:#a9b5d5;font-weight:200;font-size:24px;line-height:1}.note-bottom{bottom:94px;left:44px;color:#b0bdd5}.note-line{width:36px;height:1px;background:#7d8ca8;position:relative;margin-top:8px}.note-line:after{content:"";position:absolute;right:-4px;top:-2px;width:5px;height:5px;border-radius:50%;background:#9caac7}.scene-switcher{display:flex;gap:10px;position:absolute;right:10px;bottom:88px}.scene-switcher button{border:1px solid transparent;border-radius:50%;background:none;width:29px;height:29px;padding:7px;display:grid;place-items:center;transition:border-color .2s}.scene-switcher button[aria-pressed=true]{border-color:#8291b0}.swatch{width:12px;height:12px;border-radius:50%;display:block}.swatch.all{background:#c3cbec}.swatch.weave{background:#6eb7b4}.swatch.tessera{background:#8c80e9}.hero-bottom{height:62px;display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#8190aa;position:relative}.hero-bottom:before{content:"";position:absolute;top:0;inset-inline:64px;height:1px;background:var(--line)}.scroll-cue{display:flex;align-items:center;gap:10px}.scroll-cue>span{width:12px;height:18px;border:1px solid #71809a;border-radius:7px;position:relative}.scroll-cue>span:before{content:"";height:4px;width:1px;background:#bac7de;position:absolute;top:3px;left:5px}.hero-signature{font-size:11px;letter-spacing:.04em}.hero-signature i{font-style:normal;color:#c2cae0;margin-left:8px}.location-dot{display:flex;align-items:center;gap:8px}.location-dot:before{content:"";width:4px;height:4px;border-radius:50%;background:#87b7a8}
  .works{padding-top:104px;padding-bottom:110px}.section-top{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:44px;gap:25px}.section-top .eyebrow{margin-bottom:15px;font-size:11px;color:#8897b2;letter-spacing:.06em}.section-top h2{font-size:36px;letter-spacing:-.035em;font-weight:500}.small-star{font-size:28px;color:#8495bc;font-weight:300;margin-left:22px;vertical-align:middle}.section-aside{font-size:12px;color:#8594af;line-height:1.9}.project-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px}.project-stage{height:380px;display:flex;flex-direction:column;position:relative;overflow:hidden;border:1px solid #ffffff13;border-radius:12px;transition:border-color .4s,box-shadow .4s}.project-stage:hover{border-color:#ffffff3d;box-shadow:0 15px 50px #0003}.stage-top,.stage-bottom{display:flex;justify-content:space-between;align-items:center;position:relative;z-index:2}.stage-top{padding:24px 28px;font-size:10px;color:#c5d2dd82}.stage-brand{display:flex;align-items:center;gap:10px;font-size:15px;letter-spacing:-.03em;color:#edf5f4}.stage-brand img{object-fit:contain}.stage-bottom{margin-top:auto;padding:18px 28px;font-size:11px;color:#a5beba}.stage-bottom b{font-weight:400;margin:0 8px;color:#5f9d91}.round-arrow{width:30px;height:30px;border:1px solid #ffffff26;border-radius:50%;display:grid;place-items:center;color:#e1e8f1;font-size:16px;transition:background .25s}.project-stage:hover .round-arrow{background:#ffffff18}.weave-stage{background:radial-gradient(ellipse at 65% 30%,#20484e88,transparent 68%),#102426}.weave-illustration{position:relative;flex:1;min-height:0}.weave-connections{position:absolute;width:100%;height:100%;inset:0}.idea-node{position:absolute;top:39%;left:5%;font-size:10px;border:1px solid #77bda443;border-radius:6px;background:#203d3c;padding:12px;color:#cae5d9}.idea-node i{width:4px;height:4px;background:#76bfaa;display:block;position:absolute;right:-2px;top:50%;border-radius:50%}.tree-items{position:absolute;left:3