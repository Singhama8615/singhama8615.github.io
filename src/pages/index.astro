  .tessera-stage{background:radial-gradient(ellipse at 52% 44%,#51428750,transparent 70%),#171829}.tessera-stage .stage-bottom{color:#b2abc9}.tile-illustration{position:relative;flex:1;min-height:0;display:grid;place-items:center}.tile-grid{display:grid;grid-template-columns:repeat(3,78px);grid-template-rows:repeat(3,64px);gap:9px;transform:perspective(700px) rotateX(24deg) rotateZ(-13deg);transition:transform .7s var(--ease)}.tessera-stage:hover .tile-grid{transform:perspective(700px) rotateX(8deg) rotateZ(-4deg)}.tool-tile{border-radius:10px;border:1px solid #7d6cb132;background:linear-gradient(140deg,#343047,#242139);box-shadow:0 5px 0 #151522,0 10px 18px #0003;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:#c3bada}.tool-tile>span{font-size:25px;line-height:1;font-weight:300}.tool-tile>small{font-size:6px;color:#a49bbd}.tile-center{background:#533afd;border-color:#8e7dff;transform:translateY(-14px);box-shadow:0 5px 0 #302088,0 15px 23px #0005}.tile-center img{width:36px;height:36px;transform:rotate(13deg)}.tile-empty{border-style:dashed;background:transparent;box-shadow:none;opacity:.5}.project-description{margin-top:25px;display:flex;align-items:flex-start;gap:15px;justify-content:space-between}.project-description h3{font-size:26px;font-weight:500;letter-spacing:-.045em;display:flex;align-items:center;gap:12px}.project-description h3>span{font-size:13px;letter-spacing:.05em;font-weight:400;color:#8393ae}.project-description p{font-size:12px;color:#93a1ba;margin-top:12px}.status{font-size:10px;color:#9cb5ad;display:flex;align-items:center;gap:6px;margin-top:10px;white-space:nowrap}.status i{width:4px;height:4px;border-radius:50%;background:#8db4a1}.project-tags{display:flex;gap:8px;margin-top:20px}.project-tags>span{font-size:10px;border:1px solid var(--line);padding:5px 10px;border-radius:4px;color:#8292ae}
  .lab-section{padding-block:83px 65px;background:#0c1424;border-block:1px solid #a7bce90d}.lab-label{display:flex;align-items:center;gap:7px;font-size:11px;color:#9cacc4}.lab-label i{width:5px;height:5px;background:#bba681;border-radius:50%}.experiments{display:grid;grid-template-columns:1fr 1fr;gap:32px}.experiment{position:relative;display:flex;gap:24px;align-items:center;padding:32px 0;border-top:1px solid var(--line)}.experiment-art{width:100px;height:114px;flex-shrink:0;position:relative;display:grid;place-items:center}.reflection i{position:absolute;inset:10px 22px;border:1px solid #8498a63d;background:#66849107;transform:rotate(-15deg);border-radius:5px}.reflection i:nth-child(2){transform:rotate(0)}.reflection i:nth-child(3){transform:rotate(15deg)}.reflection span{font-size:11px;color:#9aafc3;z-index:1}.creation-orbit{position:absolute;width:95px;height:42px;border:1px solid #ac97cb50;transform:rotate(-40deg);border-radius:50%}.creation-orbit:nth-child(2){transform:rotate(40deg)}.creation span{font-size:44px;color:#b0a1d7;font-weight:200;text-shadow:0 0 25px #c9a4fc44}.experiment-category{font-size:9px;color:#71829f;letter-spacing:.07em}.experiment h3{font-size:23px;letter-spacing:-.04em;font-weight:400;margin-top:9px}.experiment h4{font-size:12px;font-weight:400;color:#b6c0d3;margin:11px 0 8px}.experiment p{font-size:11px;line-height:1.8;color:#7f90ac;max-width:280px}.experiment-status{position:absolute;right:0;top:34px;font-size:9px;border:1px solid #ffffff13;color:#9a8f79;border-radius:20px;padding:4px 9px}.lab-footnote{font-size:11px;text-align:center;margin-top:20px;color:#6f819e}
  .about-section{display:grid;grid-template-columns:1fr 1fr;gap:32px;padding-block:110px 120px}.about-identity{display:flex;flex-direction:column;align-items:center;justify-content:center}.signature-mark{font-size:130px;letter-spacing:-.1em;font-weight:200;font-style:italic;line-height:1;color:#b8c4de;position:relative}.signature-mark:before{content:"";position:absolute;inset:-50px -65px;border:1px solid #9eacd61c;border-radius:50%;transform:rotate(-25deg) scaleY(.62)}.signature-mark span{color:#7085b3}.about-identity>span{color:#72839e;font-size:10px;letter-spacing:.13em;margin-top:48px}.about-copy>.eyebrow{font-size:10px;letter-spacing:.07em;margin-bottom:22px}.about-copy h2{font-size:37px;line-height:1.5;font-weight:400;letter-spacing:-.035em;margin-bottom:27px}.about-copy>p:not(.eyebrow){font-size:12px;line-height:1.95;color:#8e9db6;margin-bottom:16px}.about-github{font-size:12px;color:#c0cce3;border-bottom:1px solid #8194be55;padding-bottom:10px;display:inline-flex;align-items:center;gap:33px;margin-top:14px}
