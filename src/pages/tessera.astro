---
import SiteLayout from '../layouts/SiteLayout.astro';
import Scene from '../components/Scene.astro';

const downloadUrl = 'https://github.com/cyamz/Tessera/releases/latest';
const issuesUrl = 'https://github.com/cyamz/Tessera/issues';
---

<SiteLayout
  title="Tessera 千机｜可扩展的 Windows 桌面工具箱"
  description="计算、换算、截图、文件与图片工具以插件形式装载。Tessera 是本地优先、可扩展的 Windows 桌面工具箱。"
  theme="tessera"
>
  <section class="hero" aria-labelledby="tessera-title">
    <div class="hero-grid container">
      <div class="hero-copy">
        <div class="brand-line">
          <img src="/brand/tessera.svg" width="38" height="38" alt="" />
          <span>Tessera™ · 千机</span>
        </div>
        <p class="eyebrow">Windows desktop toolbox</p>
        <h1 id="tessera-title">工具，应该在<br />需要时就位。</h1>
        <p class="lead">
          计算、截图、文件、图片和时间能力，像模块一样装进同一个工作台。
          日常数据保存在本机，无需云端账号。
        </p>
        <div class="hero-actions">
          <a class="button primary" href={downloadUrl} target="_blank" rel="noreferrer">
            下载 Windows 版
            <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="#try-it">先试两个小工具 <span aria-hidden="true">↓</span></a>
        </div>
        <p class="release-note">Windows 10 / 11 · x64 · 免安装 ZIP · 提供 SHA256 校验</p>
      </div>

      <div class="hero-stage" aria-label="Tessera 模块装配视觉">
        <div class="scene-shell">
          <Scene variant="tessera" />
          <div class="socket-label socket-label--top" aria-hidden="true">
            <span>CAPTURE</span><i></i>
          </div>
          <div class="socket-label socket-label--right" aria-hidden="true">
            <span>CONVERT</span><i></i>
          </div>
          <div class="socket-label socket-label--bottom" aria-hidden="true">
            <span>FILES</span><i></i>
          </div>
        </div>
        <div class="status-strip" aria-hidden="true">
          <span><i></i>LOCAL RUNTIME</span>
          <span>MODULES / READY</span>
          <span>WIN · X64</span>
        </div>
      </div>
    </div>
    <div class="hero-ruler" aria-hidden="true"><span></span><span></span><span></span></div>
  </section>

  <section class="manifesto container" aria-labelledby="manifesto-title">
    <div>
      <p class="eyebrow">One shell, many capabilities</p>
      <h2 id="manifesto-title">一套界面，<br />装下常用能力。</h2>
    </div>
    <p>
      Tessera 把每项工具当作独立插件：可以收藏、停用，也可以按契约继续扩展。
      插件包使用 <code>.scp</code> 格式和签名校验；需要独立进程的能力隔离运行。
    </p>
  </section>

  <section class="workbench" aria-labelledby="workbench-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Tool surface</p>
          <h2 id="workbench-title">一张工具台，多种工作状态。</h2>
        </div>
        <p>选择一组能力，查看 Tessera 桌面端的结构化预览。</p>
      </div>

      <div class="tool-window">
        <div class="tool-tabs" role="tablist" aria-label="工具分类">
          <button id="tab-calc" role="tab" aria-selected="true" aria-controls="panel-calc" data-tool-tab="calc">
            <span aria-hidden="true">⌁</span><b>计算与换算</b><small>CALCULATE</small>
          </button>
          <button id="tab-capture" role="tab" aria-selected="false" aria-controls="panel-capture" data-tool-tab="capture" tabindex="-1">
            <span aria-hidden="true">⌗</span><b>截图与标注</b><small>CAPTURE</small>
          </button>
          <button id="tab-files" role="tab" aria-selected="false" aria-controls="panel-files" data-tool-tab="files" tabindex="-1">
            <span aria-hidden="true">▤</span><b>文件中心</b><small>FILES</small>
          </button>
          <button id="tab-create" role="tab" aria-selected="false" aria-controls="panel-create" data-tool-tab="create" tabindex="-1">
            <span aria-hidden="true">◫</span><b>图片与文本</b><small>CREATE</small>
          </button>
        </div>

        <div class="tool-preview">
          <div class="window-bar">
            <div class="window-brand"><img src="/brand/tessera-indigo.svg" alt="" /> Tessera</div>
            <div class="window-search">搜索工具或命令 <kbd>Ctrl</kbd> <kbd>K</kbd></div>
            <div class="window-actions" aria-hidden="true"><i></i><i></i><i></i></div>
          </div>

          <section id="panel-calc" role="tabpanel" aria-labelledby="tab-calc" data-tool-panel="calc">
            <div class="preview-heading"><span>科学计算器</span><b>表达式与函数图形</b></div>
            <div class="calculator-preview">
              <div class="expression"><small>表达式</small><strong>sin(π / 4) × 12²</strong><output>101.823</output></div>
              <svg viewBox="0 0 520 160" role="img" aria-label="函数曲线概念预览">
                <path class="grid-line" d="M0 32H520M0 80H520M0 128H520M104 0V160M208 0V160M312 0V160M416 0V160" />
                <path class="curve" d="M0 107C44 101 58 36 102 43s57 91 101 80 60-99 105-91 49 107 104 91 54-78 108-66" />
              </svg>
              <div class="key-row" aria-hidden="true"><span>sin</span><span>cos</span><span>tan</span><span>ln</span><b>=</b></div>
            </div>
          </section>

          <section id="panel-capture" role="tabpanel" aria-labelledby="tab-capture" data-tool-panel="capture" hidden>
            <div class="preview-heading"><span>截图工作台</span><b>区域截图 · 标注 · 贴图 · 取色</b></div>
            <div class="capture-preview">
              <div class="desktop-fragment">
                <span class="capture-frame"><i></i><i></i><i></i><i></i><b>1280 × 720</b></span>
              </div>
              <div class="annotation-rail" aria-hidden="true"><span>↖</span><span>□</span><span>↗</span><span>T</span><span>◉</span></div>
              <p>桌面能力预览：实际区域选择、屏幕捕获和贴图在 Windows 应用中运行。</p>
            </div>
          </section>

          <section id="panel-files" role="tabpanel" aria-labelledby="tab-files" data-tool-panel="files" hidden>
            <div class="preview-heading"><span>文件中心</span><b>多文件夹工作台与内置查看器</b></div>
            <div class="files-preview">
              <div class="folder-tree"><b>工作区</b><span class="active">▾ 项目资料</span><span>　▰ 设计稿</span><span>　▰ 发布文件</span><span>　▰ 参考资料</span></div>
              <div class="file-list"><span><b>产品说明.pdf</b><small>2.4 MB</small></span><span><b>展示封面.png</b><small>1.8 MB</small></span><span><b>发布清单.txt</b><small>8 KB</small></span></div>
              <div class="file-preview"><i></i><i></i><i></i><small>内置预览</small></div>
            </div>
          </section>

          <section id="panel-create" role="tabpanel" aria-labelledby="tab-create" data-tool-panel="create" hidden>
            <div class="preview-heading"><span>处理实验室</span><b>图片转换、水印、背景移除与文本工具</b></div>
            <div class="create-preview">
              <div class="image-sample"><span>PNG</span><i></i><strong>2400 × 1600</strong></div>
              <div class="process-line"><span>原始文件</span><i></i><b>转换 + 压缩</b><i></i><span>WEBP</span></div>
              <div class="create-result"><strong>1.82 MB</strong><span>→</span><strong>624 KB</strong></div>
            </div>
          </section>
        </div>
      </div>
      <p class="concept-note">界面为产品能力的概念预览；桌面捕获和本机文件访问只在下载后的 Windows 应用中执行。</p>
    </div>
  </section>

  <section class="try-section container" id="try-it" aria-labelledby="try-title">
    <div class="try-intro">
      <p class="eyebrow">Live browser demo</p>
      <h2 id="try-title">先在这里，<br />用两个小工具。</h2>
      <p>这两个体验直接在当前页面运行，不上传输入内容。桌面版包含更完整的单位分类和文本能力。</p>
    </div>

    <div class="demo-stack">
      <form class="mini-tool converter" id="converter-form">
        <div class="mini-tool-head"><span>01</span><div><h3>长度换算</h3><p>Length converter</p></div></div>
        <div class="convert-grid">
          <label>数值<input name="value" inputmode="decimal" value="1" autocomplete="off" /></label>
          <label>从<select name="from" aria-label="原单位"><option value="m">米 m</option><option value="cm">厘米 cm</option><option value="km">千米 km</option><option value="in">英寸 in</option><option value="ft">英尺 ft</option><option value="mi">英里 mi</option></select></label>
          <button type="button" class="swap-button" data-swap aria-label="交换单位">⇄</button>
          <label>到<select name="to" aria-label="目标单位"><option value="cm">厘米 cm</option><option value="m">米 m</option><option value="km">千米 km</option><option value="in">英寸 in</option><option value="ft">英尺 ft</option><option value="mi">英里 mi</option></select></label>
        </div>
        <div class="tool-result" aria-live="polite"><small>换算结果</small><output id="convert-result">100</output><span id="convert-unit">cm</span></div>
        <p class="input-error" id="convert-error" role="status" hidden>请输入有效数值。</p>
      </form>

      <div class="mini-tool text-tool">
        <div class="mini-tool-head"><span>02</span><div><h3>文本整理</h3><p>Text cleaner</p></div></div>
        <label class="sr-only" for="text-input">要整理的文本</label>
        <textarea id="text-input" rows="6">Tessera 把常用工具，  


装进同一个工作台。</textarea>
        <div class="text-meta" aria-live="polite">
          <span><b id="text-characters">0</b> 字符</span>
          <span><b id="text-lines">0</b> 行</span>
          <span><b id="text-words">0</b> 词组</span>
          <button type="button" id="clean-text">整理空行与行尾空格</button>
        </div>
      </div>
    </div>
  </section>

  <section class="local-section" aria-labelledby="local-title">
    <div class="container local-grid">
      <div class="local-visual" aria-hidden="true">
        <div class="core-mark"><img src="/brand/tessera-hero.svg" alt="" /></div>
        <span class="orbit orbit-one"><i></i></span>
        <span class="orbit orbit-two"><i></i><i></i></span>
      </div>
      <div class="local-copy">
        <p class="eyebrow">Local by default</p>
        <h2 id="local-title">你的工具，<br />你的机器，<br />你的数据。</h2>
        <p>无需云端账号。收藏与设置留在本机；插件式结构让功能可以停用、替换和继续扩展。</p>
        <dl>
          <div><dt>本地运行</dt><dd>日常数据不依赖账号同步</dd></div>
          <div><dt>插件隔离</dt><dd>需要独立进程的能力隔离运行</dd></div>
          <div><dt>签名校验</dt><dd><code>.scp</code> 插件包支持 ed25519 校验</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="appearance container" aria-labelledby="appearance-title">
    <div class="appearance-copy">
      <p class="eyebrow">Fits the way you work</p>
      <h2 id="appearance-title">明暗同构，密度可调。</h2>
      <p>跟随系统明暗模式，在多套界面风格之间切换，并按屏幕和习惯调整信息密度。中英文界面都可使用。</p>
    </div>
    <div class="theme-plates" aria-label="亮色与暗色界面概念展示">
      <div class="theme-plate light"><span>LIGHT / WARM LIFE</span><div><i></i><b></b><em></em></div></div>
      <div class="theme-plate dark"><span>DARK / PROFESSIONAL</span><div><i></i><b></b><em></em></div></div>
    </div>
  </section>

  <section class="faq container" aria-labelledby="faq-title">
    <div>
      <p class="eyebrow">Before download</p>
      <h2 id="faq-title">下载之前</h2>
    </div>
    <div class="questions">
      <details open><summary>当前支持哪些系统？</summary><p>当前发布版面向 Windows 10 / 11 x64，提供免安装 ZIP，解压后运行 <code>toolbox_host.exe</code>。</p></details>
      <details><summary>需要注册账号吗？</summary><p>不需要。Tessera 的日常数据保存在本地，不依赖云端账号。</p></details>
      <details><summary>网页中的演示等于完整产品吗？</summary><p>不是。当前页面的换算与文本整理是轻量浏览器体验；截图、文件访问、图片处理等能力需要 Windows 桌面应用。</p></details>
      <details><summary>如何确认下载文件完整？</summary><p>每个发布版本都附有 <code>SHA256SUMS.txt</code>，可以用它核对 ZIP 文件的 SHA256 摘要。</p></details>
    </div>
  </section>

  <section class="final-cta">
    <div class="container final-cta-inner">
      <div><img src="/brand/tessera.svg" width="48" height="48" alt="" /><p>Tessera™ · 千机</p></div>
      <h2>下一件事，<br />少开一个应用。</h2>
      <div class="final-actions"><a class="button primary" href={downloadUrl} target="_blank" rel="noreferrer">获取 Windows 版 ↗</a><a href={issuesUrl} target="_blank" rel="noreferrer">提交建议</a></div>
    </div>
  </section>
</SiteLayout>

<script>
  import { convertLength, inspectText, normalizeText } from '../scripts/tessera-tools.mjs';

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tool-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-tool-panel]')];

  function selectTool(tab: HTMLButtonElement) {
    const key = tab.dataset.toolTab;
    tabs.forEach((item) => {
      const active = item === tab;
      item.setAttribute('aria-selected', String(active));
      item.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => { panel.hidden = panel.dataset.toolPanel !== key; });
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectTool(tab));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowDown', 'ArrowUp', 'ArrowRight', 'ArrowLeft'].includes(event.key)) return;
      event.preventDefault();
      const direction = ['ArrowDown', 'ArrowRight'].includes(event.key) ? 1 : -1;
      const next = tabs[(index + direction + tabs.length) % tabs.length];
      selectTool(next);
      next.focus();
    });
  });

  const converter = document.querySelector<HTMLFormElement>('#converter-form');
  if (converter) {
    const value = converter.elements.namedItem('value') as HTMLInputElement;
    const from = converter.elements.namedItem('from') as HTMLSelectElement;
    const to = converter.elements.namedItem('to') as HTMLSelectElement;
    const result = converter.querySelector<HTMLOutputElement>('#convert-result');
    const unit = converter.querySelector<HTMLElement>('#convert-unit');
    const error = converter.querySelector<HTMLElement>('#convert-error');

    converter.addEventListener('submit', (event) => event.preventDefault());

    const updateConversion = () => {
      const converted = convertLength(value.value, from.value, to.value);
      const valid = converted !== null;
      value.setAttribute('aria-invalid', String(!valid));
      if (result) result.value = valid ? converted : '—';
      if (unit) unit.textContent = to.value;
      if (error) error.hidden = valid;
    };

    converter.addEventListener('input', updateConversion);
    converter.querySelector<HTMLButtonElement>('[data-swap]')?.addEventListener('click', () => {
      [from.value, to.value] = [to.value, from.value];
      updateConversion();
    });
  }

  const textInput = document.querySelector<HTMLTextAreaElement>('#text-input');
  const characters = document.querySelector<HTMLElement>('#text-characters');
  const lines = document.querySelector<HTMLElement>('#text-lines');
  const words = document.querySelector<HTMLElement>('#text-words');

  const updateTextStats = () => {
    if (!textInput) return;
    const stats = inspectText(textInput.value);
    if (characters) characters.textContent = String(stats.characters);
    if (lines) lines.textContent = String(stats.lines);
    if (words) words.textContent = String(stats.words);
  };

  textInput?.addEventListener('input', updateTextStats);
  document.querySelector<HTMLButtonElement>('#clean-text')?.addEventListener('click', () => {
    if (!textInput) return;
    textInput.value = normalizeText(textInput.value);
    updateTextStats();
    textInput.focus();
  });
  updateTextStats();
</script>

<style>
  :global(body[data-theme='tessera']) { background: #f6f5fb; color: #191927; }
  :global(body[data-theme='tessera'] .site-header) { --header-ink: #f3f3fa; --header-line: rgba(255,255,255,.13); }
  .hero { position: relative; overflow: hidden; min-height: 780px; padding: 128px 0 64px; color: #f3f3fa; background: #0b0b11; }
  .hero::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .38; background-image: linear-gradient(rgba(132,124,255,.09) 1px, transparent 1px), linear-gradient(90deg, rgba(132,124,255,.09) 1px, transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(to bottom, #000, transparent 90%); }
  .hero::after { content: ''; position: absolute; width: 760px; height: 760px; top: -210px; right: -130px; border-radius: 50%; background: radial-gradient(circle, rgba(83,58,253,.22), transparent 64%); filter: blur(12px); }
  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: .88fr 1.12fr; gap: 52px; align-items: center; }
  .brand-line { display: flex; align-items: center; gap: 13px; margin-bottom: 52px; color: #fff; font-size: 14px; font-weight: 650; letter-spacing: .14em; }
  .brand-line img { width: 38px; height: 38px; }
  .hero .eyebrow, .local-section .eyebrow { color: #a8a1ff; }
  .hero h1 { max-width: 700px; margin: 16px 0 28px; font-size: clamp(52px, 6.2vw, 86px); font-weight: 550; line-height: 1.2; letter-spacing: -.05em; }
  .lead { max-width: 590px; color: #b3b3c7; font-size: clamp(17px, 1.55vw, 21px); line-height: 1.75; }
  .hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 38px; }
  .hero .button.primary, .final-cta .button.primary { color: #fff; background: #533afd; box-shadow: 0 16px 50px rgba(83,58,253,.26); }
  .text-link { color: #f3f3fa; font-size: 14px; text-decoration: none; border-bottom: 1px solid #555568; padding: 12px 0 7px; }
  .release-note { margin-top: 22px; color: #77778f; font-size: 12px; letter-spacing: .04em; }
  .hero-stage { position: relative; min-width: 0; }
  .scene-shell { position: relative; min-height: 560px; border: 1px solid #222233; background: radial-gradient(circle at 50% 46%, #191637, #0c0c13 62%); box-shadow: inset 0 0 0 10px #0e0e16, 0 35px 100px rgba(0,0,0,.38); clip-path: polygon(0 34px, 34px 0, 100% 0, 100% calc(100% - 34px), calc(100% - 34px) 100%, 0 100%); }
  .scene-shell::before, .scene-shell::after { content: ''; position: absolute; z-index: 2; width: 48px; height: 1px; background: #847cff; }
  .scene-shell::before { top: 17px; left: 13px; transform: rotate(-45deg); }
  .scene-shell::after { right: 13px; bottom: 17px; transform: rotate(-45deg); }
  .scene-shell :global(.scene) { width: 100%; height: 560px; }
  .socket-label { position: absolute; z-index: 3; display: flex; gap: 10px; align-items: center; color: #6f6f88; font: 10px/1 Consolas, monospace; letter-spacing: .15em; }
  .socket-label i { display: block; width: 38px; height: 1px; background: #37374b; }
  .socket-label--top { top: 26px; right: 28px; }.socket-label--right { right: 20px; top: 52%; transform: rotate(90deg) translateX(50%); transform-origin: right; }.socket-label--bottom { left: 26px; bottom: 25px; }
  .status-strip { display: flex; justify-content: space-between; padding: 14px 18px 0; color: #656579; font: 10px/1.4 Consolas, monospace; letter-spacing: .12em; }
  .status-strip span:first-child { color: #9c98c2; }.status-strip i { display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 7px; background: #847cff; box-shadow: 0 0 12px #847cff; }
  .hero-ruler { position: absolute; bottom: 0; left: 0; width: 100%; height: 25px; border-top: 1px solid #222233; background: repeating-linear-gradient(90deg, transparent 0 71px, #2a2a3b 71px 72px); }
  .hero-ruler span { position: absolute; height: 8px; width: 1px; background: #847cff; }.hero-ruler span:nth-child(1){left:14%}.hero-ruler span:nth-child(2){left:50%}.hero-ruler span:nth-child(3){left:84%}

  .manifesto { display: grid; grid-template-columns: 1fr 1fr; gap: 11%; align-items: end; padding-top: 140px; padding-bottom: 140px; }
  .manifesto h2, .section-head h2, .try-intro h2, .local-copy h2, .appearance h2, .faq h2 { margin: 14px 0 0; font-size: clamp(38px, 4.7vw, 68px); line-height: 1.2; letter-spacing: -.045em; }
  .manifesto > p { margin: 0 0 8px; color: #5e5e75; font-size: 18px; line-height: 1.9; }
  code { padding: .12em .42em; border-radius: 4px; background: rgba(83,58,253,.08); color: #533afd; font-family: Consolas, monospace; font-size: .88em; }

  .workbench { padding: 126px 0 120px; background: #ededf5; border-block: 1px solid #e1e0f1; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 50px; margin-bottom: 52px; }
  .section-head h2 { max-width: 820px; font-size: clamp(38px, 4.2vw, 62px); }
  .section-head > p { max-width: 330px; margin: 0 0 8px; color: #6a6a85; line-height: 1.7; }
