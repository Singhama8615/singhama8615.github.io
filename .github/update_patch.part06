  blocks=list(re.finditer(r'<script(?P<a>[^>]*)>(?P<b>.*?)</script>',text,re.S|re.I)); target=next(m for m in blocks if 'busca.json' in m.group('b'))
  text=text[:target.start()]+'<script'+target.group('a')+'>'+SEARCH_SCRIPT+'</script>'+text[target.end():]
 path.write_text(text,encoding='utf-8')

for rel in ('MANUTENCAO.md','cca-atualizacoes.zip','.github/update_patch.py','.github/workflows/apply-update.yml',*[f'.github/update_patch.part{i:02d}' for i in range(1,7)],'.github/update_patch.part055'):
 p=ROOT/rel
 if p.exists(): p.unlink()

class P(HTMLParser):
 def __init__(self): super().__init__(convert_charrefs=True); self.ids=[]; self.refs=[]
 def handle_starttag(self,t,attrs):
  a=dict(attrs)
  if a.get('id'): self.ids.append(a['id'])
  for k in ('href','src'):
   if a.get(k): self.refs.append(a[k])
def parse(p): q=P(); q.feed(p.read_text(encoding='utf-8')); return q
htmls=[p for p in ROOT.rglob('*.html') if '.git' not in p.parts]; assert len(htmls)==21
parsed={p:parse(p) for p in htmls}
for p,d in parsed.items():
 assert len(d.ids)==len(set(d.ids))
 for v in d.refs:
  if v.startswith(('http://','https://','mailto:','tel:','javascript:','data:')): continue
  if v.startswith('#'): target=p; frag=v[1:]
  else:
   raw=v.split('?',1)[0]; raw,_,frag=raw.partition('#'); target=ROOT/raw.lstrip('/') if raw.startswith('/') else (p.parent/unquote(raw)).resolve()
  assert target.exists(), f'Recurso ausente: {p.relative_to(ROOT)} -> {v}'
  if frag and target.suffix.lower()=='.html': assert unquote(frag) in parsed[target].ids
search=json.loads(idx.read_text(encoding='utf-8')); assert len(search)==45 and len({(x['t'].casefold(),x['u']) for x in search})==45
for x in search:
 raw,_,frag=x['u'].partition('#'); target=ROOT/'guias'/raw; assert target.exists()
 if frag: assert frag in parsed[target].ids
for rel,h in original.items(): assert sha256(ROOT/rel)==h, f'Imagem alterada: {rel}'
imgs=[p for p in ROOT.rglob('*') if p.is_file() and p.suffix.lower() in {'.png','.jpg','.jpeg','.webp','.gif'} and '.git' not in p.parts]; assert len(imgs)==187
for p in imgs:
 b=p.read_bytes(); e=p.suffix.lower(); assert (e=='.png' and b.startswith(b'\x89PNG\r\n\x1a\n')) or (e=='.webp' and b[:4]==b'RIFF' and b[8:12]==b'WEBP') or (e in {'.jpg','.jpeg'} and b[:2]==b'\xff\xd8') or (e=='.gif' and b[:6] in {b'GIF87a',b'GIF89a'})
assert (ROOT/'guias/assets/fonts/InterVariable.woff2').read_bytes()[:4]==b'wOF2'
files=[p for p in ROOT.rglob('*') if p.is_file() and '.git' not in p.parts]; assert len(files)==212
print(f'OK: {len(files)} arquivos, {len(imgs)} imagens, {len(search)} intenções de busca')
