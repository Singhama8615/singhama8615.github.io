SEARCH_SCRIPT='(()=>{\nconst campo=document.getElementById(\'campo-busca\');\nconst lista=document.getElementById(\'busca-resultados\');\nconst status=document.getElementById(\'busca-status\');\nif(!campo||!lista)return;\nlet dados=null,sel=-1;\nconst norm=t=>(t||\'\').normalize(\'NFD\').replace(/[\\u0300-\\u036f]/g,\'\').toLowerCase().replace(/[^a-z0-9\\s]/g,\' \').replace(/\\s+/g,\' \').trim();\nasync function carrega(){\n  if(dados)return;\n  try{\n    const resposta=await fetch(\'assets/busca.json\',{cache:\'no-cache\'});\n    if(!resposta.ok)throw new Error(\'Falha ao carregar índice\');\n    dados=await resposta.json();\n    dados.forEach(e=>{e._t=norm(e.t);e._k=norm(e.k);e._d=norm(e.d);});\n  }catch(_){\n    dados=[];\n    if(status)status.textContent=\'A busca não pôde ser carregada. Use os links das áreas abaixo.\';\n  }\n}\nfunction pontua(e,termos,frase){\n  let p=0;\n  if(frase&&e._t===frase)p+=20;\n  else if(frase&&e._t.startsWith(frase))p+=10;\n  else if(frase&&e._t.includes(frase))p+=6;\n  for(const q of termos){\n    if(e._t===q)p+=8;\n    else if(e._t.startsWith(q))p+=5;\n    else if(e._t.includes(q))p+=4;\n    else if(e._k.includes(q))p+=2;\n    else if(e._d.includes(q))p+=1;\n    else return 0;\n  }\n  return p;\n}\nfunction limpaSelecao(){\n  sel=-1;\n  campo.removeAttribute(\'aria-activedescendant\');\n}\nfunction render(res,q){\n  lista.innerHTML=\'\';\n  limpaSelecao();\n  if(!q){\n    lista.removeAttribute(\'data-aberto\');\n    campo.setAttribute(\'aria-expanded\',\'false\');\n    if(status)status.textContent=\'\';\n    return;\n  }\n  if(!res.length){\n    const li=document.createElement(\'li\');\n    li.className=\'sem-resultado\';\n    li.append(\'Nenhum resultado para “\'+q+\'”. \');\n    const catalogo=document.createElement(\'a\');\n    catalogo.href=\'sei-solicitacoes-disponiveis.html\';\n    catalogo.textContent=\'Veja a lista completa de solicitações\';\n    li.append(catalogo,\' ou escreva para \');\n    const email=document.createElement(\'a\');\n    email.href=\'mailto:cca.baturite@ifce.edu.br\';\n    email.textContent=\'cca.baturite@ifce.edu.br\';\n    li.append(email,\'.\');\n    lista.appendChild(li);\n    if(status)status.textContent=\'Nenhum resultado encontrado.\';\n  }else{\n    res.forEach((e,i)=>{\n      const li=document.createElement(\'li\');\n      li.id=\'busca-opcao-\'+i;\n      li.setAttribute(\'role\',\'option\');\n      li.setAttribute(\'aria-selected\',\'false\');\n      const a=document.createElement(\'a\');\n      a.href=e.u;\n      const sistema=document.createElement(\'span\');\n      sistema.className=\'sistema\';\n      sistema.textContent=e.s;\n      const titulo=document.createElement(\'strong\');\n      titulo.textContent=e.t;\n      const descricao=document.createElement(\'small\');\n      descricao.textContent=e.d;\n      a.append(sistema,titulo,descricao);\n      li.appendChild(a);\n      li.addEventListener(\'mousemove\',()=>seleciona(i));\n      lista.appendChild(li);\n    });\n    if(status)status.textContent=res.length+(res.length===1?\' resultado encontrado.\':\' resultados encontrados.\');\n  }\n  lista.setAttribute(\'data-aberto\',\'\');\n  campo.setAttribute(\'aria-expanded\',\'true\');\n}\nfunction seleciona(indice){\n  const itens=lista.querySelectorAll(\'li[role="option"]\');\n  if(!itens.length)return;\n  sel=(indice+itens.length)%itens.length;\n  itens.forEach((li,i)=>li.setAttribute(\'aria-selected\',i===sel?\'true\':\'false\'));\n  campo.setAttribute(\'aria-activedescendant\',itens[sel].id);\n  itens[sel].scrollIntoView({block:\'nearest\'});\n}\nfunction busca(){\n  const q=campo.value.trim();\n  if(!q){render([], \'\');return;}\n  const vazias=new Set([\'a\',\'o\',\'e\',\'as\',\'os\',\'um\',\'uma\',\'de\',\'do\',\'da\',\'dos\',\'das\',\'em\',\'no\',\'na\',\'nos\',\'nas\',\'ao\',\'aos\',\'ou\',\'que\',\'por\',\'para\',\'pra\',\'com\',\'sem\',\'ser\',\'ter\',\'sou\',\'estou\',\'esta\',\'ja\',\'me\',\'se\',\'eu\',\'meu\',\'minha\',\'meus\',\'minhas\',\'vou\',\'quero\',\'queria\',\'preciso\',\'gostaria\',\'posso\',\'como\',\'faco\',\'fazer\',\'onde\',\'qual\',\'quais\',\'pelo\',\'pela\']);\n  const frase=norm(q);\n  const termos=frase.split(/\\s+/).filter(t=>t.length>1&&!vazias.has(t));\n  if(!termos.length){render([],\'\');return;}\n  const res=dados.map(e=>[pontua(e,termos,frase),e]).filter(x=>x[0]>0)\n    .sort((a,b)=>b[0]-a[0]||a[1].t.localeCompare(b[1].t,\'pt-BR\'))\n    .slice(0,8).map(x=>x[1]);\n  render(res,q);\n}\ncampo.addEventListener(\'focus\',carrega,{once:true});\ncampo.addEventListener(\'input\',async()=>{await carrega();busca();});\ncampo.addEventListener(\'keydown\',ev=>{\n  const itens=lista.querySelectorAll(\'li[role="option"]\');\n  if(ev.key===\'ArrowDown\'||ev.key===\'ArrowUp\'){\n    if(!itens.length)return;\n    ev.preventDefault();\n    seleciona(ev.key===\'ArrowDown\'?sel+1:sel-1);\n  }else if(ev.key===\'Enter\'&&sel>=0&&itens[sel]){\n    ev.preventDefault();\n    itens[sel].querySelector(\'a\').click();\n  }else if(ev.key===\'Escape\'){\n    render([],\'\');\n  }\n});\ndocument.addEventListener(\'click\',ev=>{if(!ev.target.closest(\'.busca\'))render([],\'\');});\n})();'\n